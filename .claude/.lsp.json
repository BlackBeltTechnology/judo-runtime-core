{
  "java": {
    "command": "jdtls",
    "args": [],
    "extensionToLanguage": {
      ".java": "java"
    },
    "initializationOptions": {
      "bundles": [],
      "workspaceFolders": ["file://${workspaceFolder}"]
    },
    "settings": {
      "java": {
        "home": null,
        "jdt": {
          "ls": {
            "vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m"
          }
        },
        "errors": {
          "incompleteClasspath": {
            "severity": "warning"
          }
        },
        "configuration": {
          "updateBuildConfiguration": "automatic",
          "maven": {
            "userSettings": null
          }
        },
        "trace": {
          "server": "off"
        },
        "import": {
          "maven": {
            "enabled": true
          },
          "gradle": {
            "enabled": true
          }
        },
        "autobuild": {
          "enabled": false
        },
        "format": {
          "enabled": false,
          "onType": {
            "enabled": false
          }
        },
        "saveActions": {
          "organizeImports": false
        },
        "maven": {
          "updateSnapshots": false
        },
        "completion": {
          "favoriteStaticMembers": ["org.junit.Assert.*", "org.junit.Assume.*", "org.junit.jupiter.api.Assertions.*", "org.junit.jupiter.api.Assumptions.*", "org.mockito.Mockito.*", "org.mockito.ArgumentMatchers.*"],
          "importOrder": ["java", "javax", "org", "com", "hu"]
        },
        "sources": {
          "organizeImports": {
            "starThreshold": 99,
            "staticStarThreshold": 99
          }
        },
        "codeGeneration": {
          "toString": {
            "template": "${object.className}{${member.name()}=${member.value}, ${otherMembers}}"
          },
          "hashCodeEquals": {
            "useJava7Objects": true
          },
          "useBlocks": true
        }
      }
    },
    "startupTimeout": 60000,
    "shutdownTimeout": 5000,
    "restartOnCrash": true,
    "maxRestarts": 3
  }
}
